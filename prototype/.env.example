# 复制为 .env 后，只在本机填写 API 密钥。不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 仅当你部署的接口支持 response_format=json_object 时设为 true。
DEEPSEEK_JSON_MODE=false

# 文件之间可并行整理；同一文件内仍按小批证据独立调用模型。
DEEPSEEK_ORGANIZE_CONCURRENCY=8

# 出题阶段保留思考，但默认低强度以控制响应时间。
DEEPSEEK_REASONING_EFFORT=low

PROTOTYPE_HOST=127.0.0.1
PROTOTYPE_PORT=8787
