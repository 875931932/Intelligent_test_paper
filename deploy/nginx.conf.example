server {
    listen 80;
    server_name YOUR_SERVER_DOMAIN_OR_IP;
    client_max_body_size 200m;

    root /opt/intelligent-test-paper/frontend/dist;
    index index.html;

    # 静态资源压缩：Vite 产物的大头是 JS/CSS（index-*.js ~260KB、ui-*.js ~160KB），
    # nginx 默认只压 text/html——不显式列出 gzip_types 时这些文件原样传输，
    # 慢链路（公网/校园网）首屏与切页会凭空多等好几秒。
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/wasm;

    # Vite 产物是内容哈希命名：命中 /assets/ 的资源可长缓存（文件名变了才会重新下载）。
    # index.html 反过来必须不缓存，否则新版本发布后浏览器仍引用旧 hash 的资源。
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1800s;
    }

    # MinIO/S3 直传反代（同域避免 CORS）。
    # 注意：S3_ENDPOINT 必须填站点同源根地址，且不能带 /s3 之类的前缀，
    # 因为预签名 URL 的签名是按其完整路径（/exam-materials/...）计算的，
    # location 需匹配桶名且不带结尾斜杠（桶级 head/create bucket 请求路径
    # /exam-materials 也无斜杠），并用不带结尾斜杠的 proxy_pass 原样转发，
    # 才能保证 MinIO 收到的路径与签名路径一致（否则 SigV4 校验返回 403）。
    # 桶名为 S3_BUCKET（默认 exam-materials），location 前缀需与之保持一致。
    location /exam-materials {
        client_max_body_size 200m;
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
