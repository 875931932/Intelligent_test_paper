DATABASE_URL=postgresql+psycopg://exam:exam@localhost:5432/exam
REDIS_URL=redis://localhost:6379/0
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=10
MINERU_MAX_POLL_SECONDS=1800
# LLM（OpenAI 兼容协议，端点/模型随 .env 更换）
LLM_API_KEY=
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_MODEL=step-3.7-flash
# 抽取/大纲阶段是否关闭长链路推理（true=关闭）：节省 token 并避免输出被截断
LLM_DISABLE_THINKING=true
# 出题/命题阶段是否关闭思考（true=关闭思考以缩短单次调用；false=保留思考模式）
LLM_GENERATION_DISABLE_THINKING=true
# DashScope text-embedding endpoint; API format must match its input/output schema.
EMBEDDING_BASE_URL=https://ws-jn5396bzqr92vf9r.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_FORMAT=dashscope
ORGANIZATION_RETRIEVAL_TOP_K=12
ORGANIZATION_RETRIEVAL_MIN_SCORE=0.30
# 双 query 展开（intent + 考点名+考核要求）会让候选对翻倍、垃圾分类对大增，
# 量化后默认关闭；操作/实验类考点若漏召回可改 true 试跑对比一轮垃圾率。
ORGANIZATION_RETRIEVAL_EXPAND_QUERY=false
ORGANIZATION_MAX_WORKERS=16
SEED_DEV_DATA=true
UPLOAD_MAX_BYTES=209715200
S3_ENDPOINT=http://localhost:9000
# 后端自身访问对象存储的内网地址（MinIO 实际监听地址，如 http://127.0.0.1:9000）。
# 仅当 S3_ENDPOINT 为公网/经 nginx 反代的地址且服务器无法回环访问自身公网 IP 时设置；
# 为空则后端直接使用 S3_ENDPOINT。浏览器直传的预签名 URL 始终使用 S3_ENDPOINT。
S3_INTERNAL_ENDPOINT=
S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=minio-dev-password
S3_BUCKET=exam-materials
S3_REGION=us-east-1
# 登录鉴权
AUTH_SECRET=exam-auth-dev-secret-change-me

# --- knowledge catalog per-stage model (optional) ---
# 知识目录三阶段分档选模：留空（默认）→ 统一回退 LLM_MODEL（复杂生成所用同一模型）。
# 分类只做相关性判断，可填更经济的模型降本；归并/抽取是知识蒸馏，建议留空或用强模型。
# 对应 app/config.py：llm_classify_model / llm_consolidate_model / llm_extract_model
LLM_CLASSIFY_MODEL=
LLM_CONSOLIDATE_MODEL=
LLM_EXTRACT_MODEL=
