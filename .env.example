DATABASE_URL=postgresql+psycopg://exam:exam@localhost:5432/exam
REDIS_URL=redis://localhost:6379/0
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=10
MINERU_MAX_POLL_SECONDS=1800
# LLM (小米 MiMo, OpenAI 兼容协议)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.xiaomimimo.com/v1
DEEPSEEK_MODEL=mimo-v2.5-pro
# 关闭 MiMo 思考模式（true=关闭）：大纲/抽取阶段不走长链路推理，节省 token 并避免输出被截断
DEEPSEEK_DISABLE_THINKING=true
# 出题/命题阶段是否关闭思考（false=不关闭，即出题保留思考模式以提升题目质量）
DEEPSEEK_GENERATION_DISABLE_THINKING=false
# DashScope text-embedding endpoint; API format must match its input/output schema.
EMBEDDING_BASE_URL=https://ws-jn5396bzqr92vf9r.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_FORMAT=dashscope
ORGANIZATION_RETRIEVAL_TOP_K=24
ORGANIZATION_RETRIEVAL_MIN_SCORE=0.25
ORGANIZATION_MAX_WORKERS=16
SEED_DEV_DATA=true
UPLOAD_MAX_BYTES=209715200
S3_ENDPOINT=http://localhost:9000
# 后端自身访问对象存储的内网地址（MinIO 实际监听地址，如 http://127.0.0.1:9000）。
# 仅当 S3_ENDPOINT 为公网/经 nginx 反代的地址且服务器无法回环访问自身公网 IP 时设置；
# 为空则后端直接使用 S3_ENDPOINT。浏览器直传的预签名 URL 始终使用 S3_ENDPOINT。
S3_INTERNAL_ENDPOINT=
S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=minio-dev-password
S3_BUCKET=exam-materials
S3_REGION=us-east-1
# 登录鉴权
AUTH_SECRET=exam-auth-dev-secret-change-me
